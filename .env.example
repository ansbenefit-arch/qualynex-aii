# Make your own .env from this file. Never commit .env.
PORT=4177
# Demo runs locally, without any Jira or model subscription.
# Real Jira: use your Atlassian CLOUD site, an approved account and API token.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BOARD_ID=
# Optional: custom Jira acceptance-criteria field ID, e.g. customfield_10301
JIRA_ACCEPTANCE_FIELD=
# Enables recurring assigned-sprint sync, in seconds. Set e.g. 120. 0 = off.
JIRA_POLL_SECONDS=0
# assigned: sync issues assigned to Jira token owner; sprint: sync active board sprint.
JIRA_SYNC_MODE=sprint
# Optional test case drafting. AI plans are drafts, NOT guaranteed executable tests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Jira write actions (creating bugs) are disabled by default.
JIRA_WRITE_ENABLED=0
JIRA_BUG_PROJECT_KEY=
# Runner only accepts configured origin, and production is blocked by default.
TEST_TARGET_URL=http://127.0.0.1:4177/sample-app
PLAYWRIGHT_EXECUTABLE_PATH=

# Optional bearer token for same-origin DEV/STG read-only GET API checks. Never paste into UI.
TEST_API_BEARER_TOKEN=

# QASphere v0.5 SQL Server pilot (DEV/STG only). Required for real DB checks.
# Use a dedicated DB user GRANTED SELECT ONLY on the specific approved views/tables.
# Do not configure a production or write-enabled SQL login.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Relative path to locally reviewed allowlisted queries. No SQL is accepted from the browser.
SQLSERVER_CHECKS_FILE=config/db-checks.json
# Encrypted TLS is enforced. TLS bypass (TRUST_SERVER_CERTIFICATE=1) is rejected.
SQLSERVER_TRUST_SERVER_CERTIFICATE=0

# QASphere v0.6 read-only GitHub Actions integration.
# Use an approved fine-grained token limited to this repo with Actions: Read.
# Do not use an administrator or workflow-write token.
GITHUB_REPOSITORY=
GITHUB_TOKEN=
# REQUIRED: name of a specific trusted CI workflow, e.g. ci.yml (not deployment workflow).
GITHUB_WORKFLOW=
# Poll for completed Actions builds and auto-run local mapped QA checks (>=60 seconds). 0 = off.
PIPELINE_POLL_SECONDS=0
